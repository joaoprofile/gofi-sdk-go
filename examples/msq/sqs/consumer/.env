APP_ENVIRONMENT=dev
MESSAGING_PROVIDER=sqs
# LocalStack: any credentials work. On AWS, drop these four lines and let the
# default chain (IRSA, instance profile, AWS_PROFILE) supply region and identity.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL_SQS=http://localhost:4566
