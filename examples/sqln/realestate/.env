APP_ENVIRONMENT=dev
DATABASE_DRIVER=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5435
DATABASE_NAME=imoveis
DATABASE_USER=imoveis
DATABASE_PASSWORD=secret
DATABASE_MIGRATION=true
# Logs every SQL statement sqln runs, with its arguments; false turns it off.
DATABASE_LOG_QUERIES=true
# Prints the same statements indented, one argument per line, to stderr.
DATABASE_LOG_QUERIES_PRETTY=true
