APP_ENVIRONMENT=dev
# Exported as service.version on every span, metric and log.
APP_VERSION=1.0.0
# OTLP gRPC endpoint of the collector in compose.yaml; http:// means no TLS
# (OTLP uses TLS by default).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Export metrics every 5s (SDK default 60s) so the dashboards move fast.
OTEL_METRIC_EXPORT_INTERVAL=5000
# false disables the built-in traffic generator.
LOADGEN=true
